{
  "uid": "dmpf-infra-postgres",
  "title": "DMPF · Postgres",
  "description": "O Postgres dos contextos pelo postgres-exporter: conexões, volume transacional, cache, locks e WAL. Só no Compose: o Kubernetes não tem postgres-exporter.",
  "tags": ["dmpf", "infra"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "Banco",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}, datname)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Disponibilidade e conexões",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Postgres no ar",
      "description": "pg_up do postgres-exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fora",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "no ar",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_up)",
          "legendFormat": "pg_up",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Conexões sobre max_connections",
      "description": "Todas as conexões do servidor sobre o limite configurado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_activity_count) / max(pg_settings_max_connections)",
          "legendFormat": "uso",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Conexões por banco e estado",
      "description": "pg_stat_activity_count, só os estados com conexão.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname, state) (pg_stat_activity_count{datname=~\"$datname\"}) > 0",
          "legendFormat": "{{datname}} {{state}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "row",
      "id": 5,
      "title": "Volume transacional",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Commits por banco",
      "description": "pg_stat_database_xact_commit: volume transacional de cada contexto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rollbacks por banco",
      "description": "pg_stat_database_xact_rollback.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tuplas escritas por banco",
      "description": "Inseridas, atualizadas e removidas, inclusive outbox e inbox.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_inserted{datname=~\"$datname\"}[$__rate_interval]) + rate(pg_stat_database_tup_updated{datname=~\"$datname\"}[$__rate_interval]) + rate(pg_stat_database_tup_deleted{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      }
    },
    {
      "type": "row",
      "id": 9,
      "title": "Desempenho e contenção",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Acerto de cache",
      "description": "blks_hit sobre blks_hit + blks_read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[5m])) / clamp_min(sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[5m]) + rate(pg_stat_database_blks_read{datname=~\"$datname\"}[5m])), 1e-9)",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Locks por modo",
      "description": "pg_locks_count, só os modos com lock.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname, mode) (pg_locks_count{datname=~\"$datname\"}) > 0",
          "legendFormat": "{{datname}} {{mode}}",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Transação mais longa",
      "description": "pg_stat_activity_max_tx_duration: transação aberta demais segura lock e vacuum.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (datname, state) (pg_stat_activity_max_tx_duration{datname=~\"$datname\"})",
          "legendFormat": "{{datname}} {{state}}",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Deadlocks na janela",
      "description": "pg_stat_database_deadlocks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (increase(pg_stat_database_deadlocks{datname=~\"$datname\"}[$__range]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Arquivos temporários",
      "description": "pg_stat_database_temp_bytes por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_temp_bytes{datname=~\"$datname\"}[5m]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Tamanho do banco",
      "description": "pg_database_size_bytes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (datname) (pg_database_size_bytes{datname=~\"$datname\"})",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "WAL e checkpoints",
      "description": "pg_wal_size_bytes (eixo da esquerda) e checkpoints por segundo, timed + req (eixo da direita).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_wal_size_bytes)",
          "legendFormat": "WAL",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_bgwriter_checkpoints_timed_total[5m])) + sum(rate(pg_stat_bgwriter_checkpoints_req_total[5m]))",
          "legendFormat": "checkpoints/s",
          "refId": "B"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 25
      }
    },
    {
      "type": "row",
      "id": 17,
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
