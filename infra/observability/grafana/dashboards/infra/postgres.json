      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_service=\"postgres\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "id": 18,
      "gridPos": {
