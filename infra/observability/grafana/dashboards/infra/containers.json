{
  "uid": "dmpf-infra-containers",
  "title": "DMPF · Containers e serviços de apoio",
  "description": "CPU, memória, rede e disco de cada container pelo cAdvisor, contra os tetos de deploy.resources, e os serviços de apoio (Redis, floci). Só no Compose: o Kubernetes não tem cAdvisor no scrape.",
  "tags": ["dmpf", "infra"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_last_seen{name!=\"\"}, name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "infra_service",
        "label": "Serviço de infraestrutura (logs)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(compose_service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Containers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU sobre o teto",
      "description": "Uso de CPU dividido pela quota (deploy.resources.limits.cpus).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval])) / on (name) (max by (name) (container_spec_cpu_quota{name=~\"$container\"}) / max by (name) (container_spec_cpu_period{name=~\"$container\"}))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Throttling da CPU",
      "description": "Períodos estrangulados pelo CFS sobre o total: o teto segurando o container.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_cpu_cfs_throttled_periods_total{name=~\"$container\"}[$__rate_interval])) / clamp_min(sum by (name) (rate(container_cpu_cfs_periods_total{name=~\"$container\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Memória sobre o limite",
      "description": "Working set sobre deploy.resources.limits.memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (container_memory_working_set_bytes{name=~\"$container\"}) / on (name) max by (name) (container_spec_memory_limit_bytes{name=~\"$container\"} > 0)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "OOM na janela",
      "description": "container_oom_events_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (increase(container_oom_events_total{name=~\"$container\"}[$__range])) > 0",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Rede recebida e enviada",
      "description": "container_network_*_bytes_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{name}} rx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{name}} tx",
          "refId": "B"
        }
      ],
      "interval": "2m",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Escrita em disco",
      "description": "container_fs_writes_bytes_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 17
      }
    },
    {
      "type": "stat",
      "title": "Início do container",
      "description": "container_start_time_seconds: reinício recente salta aos olhos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (container_start_time_seconds{name=~\"$container\"}) * 1000",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 17
      }
    },
    {
      "type": "row",
      "id": 9,
      "title": "Serviços de apoio (nenhuma app usa Redis nem SQS/SNS hoje)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Redis e floci no ar",
      "description": "redis_up e o probe do blackbox no floci.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fora",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "no ar",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(redis_up)",
          "legendFormat": "redis",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (instance) (probe_success)",
          "legendFormat": "floci",
          "refId": "B"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Redis: clientes e comandos",
      "description": "redis_connected_clients e comandos por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(redis_connected_clients)",
          "legendFormat": "clientes",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(redis_commands_processed_total[$__rate_interval]))",
          "legendFormat": "comandos/s",
          "refId": "B"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Redis: memória usada",
      "description": "redis_memory_used_bytes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(redis_memory_used_bytes)",
          "legendFormat": "usada",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "floci: latência do probe",
      "description": "probe_duration_seconds do blackbox.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (probe_duration_seconds)",
          "legendFormat": "floci",
          "refId": "A"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 26
      }
    },
    {
      "type": "row",
      "id": 14,
      "title": "Logs de infraestrutura",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Logs dos containers de infraestrutura",
      "description": "Coletados pelo Alloy com a label compose_service, que só existe no Compose (no Kubernetes o Alloy rotula app); por isso o painel fica neste dashboard, que é só do Compose.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_service=~\"$infra_service\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 33
      }
    }
  ]
}
