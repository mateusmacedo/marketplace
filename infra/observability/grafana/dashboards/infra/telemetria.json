{
  "uid": "dmpf-infra-telemetry",
  "title": "DMPF · Pipeline de telemetria",
  "description": "A própria observabilidade: o dado não apareceu porque a app não mandou ou porque o pipeline perdeu? Collector, Loki, Tempo, Prometheus e Grafana. Os nomes do Collector 0.160 não têm sufixo _total.",
  "tags": ["dmpf", "infra"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
