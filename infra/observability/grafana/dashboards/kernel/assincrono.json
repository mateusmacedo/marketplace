    },
    {
      "type": "timeseries",
      "title": "Falhas de envio por destino e categoria (eventos na janela)",
      "description": "_count de messaging.client.operation.duration com error.type, que só existe na falha; conta a série que nasce na janela.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_destination_name, error_type) ((increase(messaging_client_operation_duration_seconds_count{service_name=~\"$service\", messaging_destination_name=~\"$destination\", error_type!=\"\"}[$__rate_interval]) or messaging_client_operation_duration_seconds_count{service_name=~\"$service\", messaging_destination_name=~\"$destination\", error_type!=\"\"} * 0) + ((messaging_client_operation_duration_seconds_count{service_name=~\"$service\", messaging_destination_name=~\"$destination\", error_type!=\"\"} unless messaging_client_operation_duration_seconds_count{service_name=~\"$service\", messaging_destination_name=~\"$destination\", error_type!=\"\"} offset $__rate_interval) or messaging_client_operation_duration_seconds_count{service_name=~\"$service\", messaging_destination_name=~\"$destination\", error_type!=\"\"} * 0))",
          "legendFormat": "{{messaging_destination_name}} {{error_type}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 9
      }
    },
