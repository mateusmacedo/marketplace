{
  "uid": "dmpf-async",
  "title": "DMPF · Fluxo assíncrono (outbox → Kafka → inbox)",
  "description": "A escrita que sai pelo outbox, atravessa o Redpanda e entra pela inbox, com as disposições do consumo e o desfecho da idempotência.",
  "tags": ["dmpf", "kernel"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(target_info{service_name!=\"\"}, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "destination",
        "label": "Destino",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(messaging_client_sent_messages_total{service_name=~\"$service\"}, messaging_destination_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Outbox e relay",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ciclos de drenagem do outbox por serviço",
      "description": "Spanmetrics do Tempo sobre o span `outbox drain <tópico>` (classe write, guardado sempre pelo tail): o relay não tem métrica própria de ciclo (MET-18/MET-20 não emitidos).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "links": [
            {
              "title": "Traces de drenagem",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "queryType": "traceql",
                  "query": "{resource.service.name=\"${__field.labels.service}\" && name=~\"outbox drain.*\"}"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"outbox drain .*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Drenagem do outbox (p95)",
      "description": "Duração do span `outbox drain`, das spanmetrics do Tempo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Traces de drenagem",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "queryType": "traceql",
                  "query": "{resource.service.name=\"${__field.labels.service}\" && name=~\"outbox drain.*\"}"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_name=~\"outbox drain .*\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Mensagens por lote de drenagem",
      "description": "Média de messaging.batch.message_count no span `outbox drain`; substitui MET-20 (dmpf.relay.batch.size), ainda não emitido. Consulta de métrica sobre traces no Tempo: conta o que o tail sampling guardou (100% da classe write, sempre).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && name=~\"outbox drain.*\"} | avg_over_time(span.messaging.batch.message_count) by (resource.service.name)",
          "metricsQueryType": "range",
          "step": "1m",
          "refId": "A"
        }
      ],
      "interval": "1m",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Mensagens enviadas por destino",
      "description": "messaging.client.sent.messages do relay (RF-D2).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
