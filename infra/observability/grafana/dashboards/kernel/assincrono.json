      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_destination_name) (rate(messaging_client_sent_messages_total{service_name=~\"$service\", messaging_destination_name=~\"$destination\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
