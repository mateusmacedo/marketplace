{
  "uid": "dmpf-resilience",
  "title": "DMPF · Resiliência, admissão e contenção",
  "description": "Por que uma chamada falhou ou esperou: breaker, retentativa, prazo, bulkhead, admissão e o pool de banco. Contadores de evento raro contam a série que nasce no meio da janela.",
  "tags": ["dmpf", "kernel"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(target_info{service_name!=\"\"}, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instância",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(target_info{service_name=~\"$service\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "dependency",
        "label": "Dependência",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(dmpf_dependency_breaker_state{service_name=~\"$service\"}, dmpf_dependency)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(dmpf_admission_rejections_total, dmpf_tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Dependências",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Estado do breaker",
      "description": "MET-28: dmpf.dependency.breaker.state, 0 fechado, 1 meio-aberto, 2 aberto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fechado",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "meio-aberto",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "aberto",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_name, instance, dmpf_dependency) (dmpf_dependency_breaker_state{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"})",
          "legendFormat": "{{instance}} → {{dmpf_dependency}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Retentativas por dependência e categoria (eventos na janela)",
      "description": "MET-28: dmpf.dependency.retries; só o erro declarado transiente é retentado (FND-08).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, dmpf_dependency, error_type) ((increase(dmpf_dependency_retries_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"}[$__rate_interval]) or dmpf_dependency_retries_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} * 0) + ((dmpf_dependency_retries_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} unless dmpf_dependency_retries_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} offset $__rate_interval) or dmpf_dependency_retries_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} * 0))",
          "legendFormat": "{{service_name}} → {{dmpf_dependency}} {{error_type}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Prazo estourado por dependência e operação (eventos na janela)",
      "description": "MET-29: dmpf.dependency.deadline_exceeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, dmpf_dependency, dmpf_operation) ((increase(dmpf_dependency_deadline_exceeded_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"}[$__rate_interval]) or dmpf_dependency_deadline_exceeded_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} * 0) + ((dmpf_dependency_deadline_exceeded_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} unless dmpf_dependency_deadline_exceeded_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} offset $__rate_interval) or dmpf_dependency_deadline_exceeded_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} * 0))",
          "legendFormat": "{{service_name}} → {{dmpf_dependency}} {{dmpf_operation}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Recusas do bulkhead (eventos na janela)",
      "description": "dmpf.dependency.bulkhead.rejections.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, dmpf_dependency) ((increase(dmpf_dependency_bulkhead_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"}[$__rate_interval]) or dmpf_dependency_bulkhead_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} * 0) + ((dmpf_dependency_bulkhead_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} unless dmpf_dependency_bulkhead_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} offset $__rate_interval) or dmpf_dependency_bulkhead_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_dependency=~\"$dependency\"} * 0))",
          "legendFormat": "{{service_name}} → {{dmpf_dependency}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Envelope de resiliência (p95)",
      "description": "Duração do span `dmpf.resilience <dependência>` (spanmetrics do Tempo): inclui backoff e espera; comparar com o p95 do gRPC cliente mostra o custo da camada.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_name=~\"dmpf.resilience $dependency\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "gRPC cliente por método e status",
      "description": "rpc.client.call.duration do otelgrpc.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rpc_method, rpc_response_status_code) (rate(rpc_client_call_duration_seconds_count{service_name=~\"$service\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_method}} · {{rpc_response_status_code}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "Admissão",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Recusas de admissão por rota, método e tenant (eventos na janela)",
      "description": "MET-12: dmpf.admission.rejections. O tenant só aparece se estiver em METRIC_TENANTS (MET-07); os demais caem em other.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, http_route, rpc_method, dmpf_tenant_id) ((increase(dmpf_admission_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_tenant_id=~\"$tenant\"}[$__rate_interval]) or dmpf_admission_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_tenant_id=~\"$tenant\"} * 0) + ((dmpf_admission_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_tenant_id=~\"$tenant\"} unless dmpf_admission_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_tenant_id=~\"$tenant\"} offset $__rate_interval) or dmpf_admission_rejections_total{service_name=~\"$service\", instance=~\"$instance\", dmpf_tenant_id=~\"$tenant\"} * 0))",
          "legendFormat": "{{service_name}} {{http_route}}{{rpc_method}} {{dmpf_tenant_id}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "Contenção no pool de banco",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Conexões usadas sobre o máximo",
      "description": "db.client.connection.count (used) sobre db.client.connection.max.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, instance, db_client_connection_pool_name) (db_client_connection_count{service_name=~\"$service\", instance=~\"$instance\", db_client_connection_state=\"used\"}) / on (service_name, instance, db_client_connection_pool_name) sum by (service_name, instance, db_client_connection_pool_name) (db_client_connection_max{service_name=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 33
      }
    },
    {
      "type": "timeseries",
      "title": "Aquisições à espera",
      "description": "db.client.connection.pending_requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_name, instance) (db_client_connection_pending_requests{service_name=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 33
      }
    },
    {
      "type": "timeseries",
      "title": "Espera por conexão (p95)",
      "description": "db.client.connection.wait_time, só na aquisição concluída (RF-D6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name, instance) (rate(db_client_connection_wait_time_seconds_bucket{service_name=~\"$service\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      }
    },
    {
      "type": "timeseries",
      "title": "Aquisições canceladas",
      "description": "db.client.connection.timeouts: inclui o cancelamento pelo chamador (RF-D6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "0",
          "links": [
            {
              "title": "Locks e transações no Postgres",
              "url": "/d/dmpf-infra-postgres?${__url_time_range}"
            }
          ],
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, instance) (rate(db_client_connection_timeouts_total{service_name=~\"$service\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 6,
