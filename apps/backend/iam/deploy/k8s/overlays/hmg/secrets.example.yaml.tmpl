# Forma dos Secrets do iam que o overlay hmg espera no namespace. Não é resource
# do kustomization: em homologação eles vêm de um ExternalSecret/SealedSecret com
# os mesmos nomes (infra/k8s/overlays/hmg/secrets.example.yaml.tmpl).
apiVersion: v1
kind: Secret
metadata:
  name: iam
type: Opaque
stringData:
  PG_DSN: postgres://iam:REPLACE_ME@postgres.hmg.internal:5432/iam?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em
  # iam.events e iam.events.dlq (ADR-052).
  KAFKA_SASL_USERNAME: iam
  KAFKA_SASL_PASSWORD: REPLACE_ME
---
# DSN da role migradora, dona do banco (ADR-063). Só o Deployment do api o
# referencia: o Secret iam entra também no relay.
apiVersion: v1
kind: Secret
metadata:
  name: iam-migrator
type: Opaque
stringData:
  PG_MIGRATE_DSN: postgres://iam_migrator:REPLACE_ME@postgres.hmg.internal:5432/iam?sslmode=verify-full&channel_binding=require
---
apiVersion: v1
kind: Secret
metadata:
  name: iam-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
