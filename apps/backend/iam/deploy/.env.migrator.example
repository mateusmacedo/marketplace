# Credencial da migradora, só do papel api (ADR-063): o serve-api e o docker:run
# a carregam, e o deploy-env a copia para deploy/.env.migrator. Fica fora do
# .env.example porque relay e consumer também carregam aquele arquivo.
MIGRATE=true
PG_MIGRATE_DSN=postgres://iam_migrator:iam-migrator-local@localhost:5432/iam?sslmode=disable
