# BFF no host, contra o Redis do compose local (profile redis, dmpf ou keycloak)
# e o tenancy rodando no host com o deploy/.env.example dele (gRPC sem TLS, porta
# 9194). Copie para deploy/.env (pnpm nx run bff:deploy-env) e rode
# pnpm nx run bff:serve. Valores só de desenvolvimento: a senha do usuário da
# deny-list é o default do compose/redis.yml, e o token é verificado pelo
# Keycloak do compose (profile keycloak), com o operador do seed do bff; o
# token sai do POST /auth/token, que o AUTH_TOKEN_CLIENT_ID liga só em dev. O
# AUTH_DEV_MOCK fica só nas suítes de teste. O caminho do OpenAPI é relativo a
# apps/backend/bff, o cwd do serve.
OTEL_SERVICE_NAME=bff
OTEL_RESOURCE_ATTRIBUTES=service.version=local,service.instance.id=bff-local,dmpf.process.role=api,deployment.environment.name=local
HTTP_ADDR=127.0.0.1:8080
ADMIN_ADDR=127.0.0.1:8090
TENANCY_GRPC_TARGET=dns:///127.0.0.1:9194
GRPC_INSECURE=true
OIDC_ISSUER=http://keycloak.localhost:8180/realms/dmpf
OIDC_AUDIENCE=dmpf-bff
OIDC_TENANT_CLAIM=organization.*.tenant_id
AUTH_TOKEN_CLIENT_ID=marketplace-dev
REDIS_URL=redis://revocation:dmpf-local-revocation@localhost:6379/0
OIDC_REVOCATION_TTL_SECONDS=300
OIDC_BACKCHANNEL_CLIENT_ID=dmpf-portal
OIDC_SESSION_EVENTS_CLIENT_ID=dmpf-session-events
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
OPENAPI_TENANCY_PATH=../tenancy/contract/openapi/v1/openapi.yaml
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
OTEL_GO_X_OBSERVABILITY=true
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BLRP_EXPORT_TIMEOUT=3000
LOG_LEVEL=debug
