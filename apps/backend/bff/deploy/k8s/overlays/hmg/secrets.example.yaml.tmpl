# Forma dos Secrets do bff que o overlay hmg espera no namespace. Não é resource
# do kustomization: em homologação eles vêm de um ExternalSecret/SealedSecret com
# os mesmos nomes (infra/k8s/overlays/hmg/secrets.example.yaml.tmpl).
# CA que emitiu o certificado do tenancy-api (tenancy-grpc-tls); é o que o BFF confia.
apiVersion: v1
kind: Secret
metadata:
  name: bff-grpc-ca
type: Opaque
stringData:
  ca.crt: REPLACE_ME
---
# Certificado de cliente do BFF, com a URI spiffe://dmpf/bff no SAN e assinado
# pela CA de grpc-client-ca — é a identidade que o tenancy-api confia
# (GRPC_TRUSTED_CLIENTS).
apiVersion: v1
kind: Secret
metadata:
  name: bff-grpc-client
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
---
# Servidor de autorização que o BFF verifica (apps/backend/bff/README.md). O
# emissor, a audiência e a claim de tenant dependem do realm de homologação.
apiVersion: v1
kind: Secret
metadata:
  name: bff-oidc
type: Opaque
stringData:
  OIDC_ISSUER: REPLACE_ME
  OIDC_AUDIENCE: REPLACE_ME
  OIDC_TENANT_CLAIM: REPLACE_ME
