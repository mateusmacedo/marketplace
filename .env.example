# Exemplo de variáveis de ambiente. Copie para `.env` e ajuste os valores.
# O arquivo `.env` é ignorado pelo git; este `.env.example` é versionado.

# NODE_ENV=development

# O Nx carrega o `.env` da raiz em todo target: estas chaves apontam os testes de
# integração para a infra de testes (infra/test/compose.yml, que o executor
# @mateusmacedo/dmpf-plugin:test-infra sobe), separada da infra de runtime local
# (infra/local) — outro projeto Compose, outras portas e só tmpfs. As variáveis de
# cada processo de runtime ficam em apps/backend/<app>/deploy/.env.example.

# Postgres de testes: cluster_name=test, que o tb/pg exige antes de criar ou
# apagar o banco de cada teste
PG_DSN=postgres://postgres:postgres@localhost:15432/postgres?sslmode=disable

# Redpanda de testes, sem SASL, e o segundo broker, com SASL SCRAM
KAFKA_BROKERS=localhost:19092
REDPANDA_ADMIN=http://localhost:19644
KAFKA_SASL_BROKERS=localhost:19093
KAFKA_SASL_USERNAME=it
KAFKA_SASL_PASSWORD=it-secret

# floci (SQS e SNS) de testes
SQS_ENDPOINT=http://localhost:14566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Redis de testes, com o usuário ACL da deny-list de revogação
REDIS_URL=redis://revocation:dmpf-test-revocation@localhost:16379/0

KEYCLOAK_URL=http://127.0.0.1:18180
KEYCLOAK_CALLBACK_HOST=host.docker.internal
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SESSION_EVENTS_SECRET=dmpf-test-session-events
KEYCLOAK_SEED_PASSWORD=dmpf-dev-password
KEYCLOAK_SEED_OTP_SECRET=dmpfdmpfdmpfdmpfdmpf
